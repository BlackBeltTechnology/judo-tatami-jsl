@cached
operation JSL!UIMenuTableDeclaration getId(): String {
    return (self.eContainer.getId() + "/" + self.name);
}

@cached
operation JSL!UIMenuTableDeclaration getFqName(): String {
    if (self.eContainer.isDefined()) {
        return self.eContainer.getFqName() + "::" + self.name;
    }
    return self.name;
}

operation JSL!UIMenuTableDeclaration getExposedVisualElements(ves: Set): Set {
    if (ves.contains(self)) {
        return ves;
    }
    var listItem = self.referenceType;

    ves.add(self);
    ves.addAll(listItem.getExposedVisualElements(ves));

    if (self.getCreateFormModifier().isDefined()) {
        ves.addAll(self.getCreateFormModifier().form.getExposedVisualElements(ves));
    }

    if (self.getUpdateViewModifier().isDefined()) {
        ves.addAll(self.getUpdateViewModifier().view.getExposedVisualElements(ves));
    }

    return ves;
}
