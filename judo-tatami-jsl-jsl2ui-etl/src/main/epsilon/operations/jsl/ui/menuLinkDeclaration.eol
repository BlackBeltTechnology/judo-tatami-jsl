@cached
operation JSL!UIMenuLinkDeclaration getId(): String {
    return (self.eContainer.getId() + "/" + self.name);
}

@cached
operation JSL!UIMenuLinkDeclaration getFqName(): String {
    if (self.eContainer.isDefined()) {
        return self.eContainer.getFqName() + "::" + self.name;
    }
    return self.name;
}

@cached
operation JSL!UIMenuLinkDeclaration getFrontend(): JSL!UIFrontendDeclaration {
    if (self.eContainer.isDefined()) {
        return self.eContainer.getFrontend();
    }
    return null;
}

@cached
operation JSL!UIMenuLinkDeclaration getActorDeclaration(): JSL!ActorDeclaration {
    var root = self.UIFrontendDeclaration();
    if (root.isDefined()) {
        return root.getActorDeclaration();
    }
    return null;
}

operation JSL!UIMenuLinkDeclaration getExposedVisualElements(ves: Set): Set {
    if (ves.contains(self)) {
        return ves;
    }
    var viewDeclaration = self.referenceType;

    ves.add(self);
    ves.addAll(viewDeclaration.getExposedVisualElements(ves));

    if (self.getCreateFormModifier().isDefined()) {
        ves.addAll(self.getCreateFormModifier().form.getExposedVisualElements(ves));
    }

    return ves;
}
