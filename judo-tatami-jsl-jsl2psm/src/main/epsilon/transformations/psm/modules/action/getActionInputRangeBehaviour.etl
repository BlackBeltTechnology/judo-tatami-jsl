// rules for range input type for input paramter (old solution)

@lazy
@greedy
rule CreateCardinalityForGetRangeActionInputTransferTypeInputParameterOwner
    transform s: JSL!TransferActionDeclaration
    to t : JUDOPSM!Cardinality {
        t.setId("(jsl/" + s.getId() + ")/CreateCardinalityForGetRangeActionInputTransferTypeInputParameterOwner");
        t.lower = 0;
        t.upper = 1;
}

@lazy
@greedy
rule CreateCardinalityForGetRangeActionInputTransferTypeInputParameterQueryCustomizer
    transform s: JSL!TransferActionDeclaration
    to t : JUDOPSM!Cardinality {
        t.setId("(jsl/" + s.getId() + ")/CreateCardinalityForGetRangeActionInputTransferTypeInputParameterQueryCustomizer");
        t.lower = 0;
        t.upper = 1;
}

@lazy
@greedy
rule CreateTransferObjectRelationForGetRangeActionInputTransferTypeInputParameterOwner
    transform s: JSL!TransferActionDeclaration
    to t : JUDOPSM!TransferObjectRelation {
        t.setId("(jsl/" + s.getId() + ")/CreateTransferObjectRelationForGetRangeActionInputTransferTypeInputParameterOwner");
        t.name = "owner";
        t.target = s.eContainer.getTransferDeclarationEquivalent();
        t.embedded = true;
        t.cardinality = s.equivalent("CreateCardinalityForGetRangeActionInputTransferTypeInputParameterOwner");


}

@lazy
@greedy
rule CreateTransferObjectRelationForGetRangeActionInputTransferTypeInputParameterQueryCustomizer
    transform s: JSL!TransferActionDeclaration
    to t : JUDOPSM!TransferObjectRelation {
        t.setId("(jsl/" + s.getId() + ")/CreateTransferObjectRelationForGetRangeActionInputTransferTypeInputParameterQueryCustomizer");
        t.name = "queryCustomizer";
        t.target = s.parameterType.equivalent("CreateQueryCustomizerType");
        t.embedded = true;
        t.cardinality = s.equivalent("CreateCardinalityForGetRangeActionInputTransferTypeInputParameterQueryCustomizer");
}

@lazy
@greedy
rule CreateGetRangeInputTypeForInputParameter
    transform s: JSL!TransferActionDeclaration
    to t: JUDOPSM!UnmappedTransferObjectType {

        t.setId("(jsl/" + s.getId() + ")/CreateGetRangeInputTypeForInputParameter");

        t.name = "_GetRangeInput" + s.eContainer.eContainer.name.firstToUpperCase() + s.eContainer.name.firstToUpperCase() + s.name.firstToUpperCase();

        t.relations.add(s.equivalent("CreateTransferObjectRelationForGetRangeActionInputTransferTypeInputParameterOwner"));

        if (s.parameterType?.map.isDefined()) {
            t.relations.add(s.equivalent("CreateTransferObjectRelationForGetRangeActionInputTransferTypeInputParameterQueryCustomizer"));     
        }

        s.eContainer.eContainer.getModelRoot().elements.add(t);
        log.debug("Get range input type created: " + t.name);
}
