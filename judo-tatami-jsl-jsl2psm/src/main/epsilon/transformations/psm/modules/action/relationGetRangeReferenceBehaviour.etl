// rules for create get range input type

@lazy
@greedy
rule CreateCardinalityForGetRangeRelationTransferTypeInputOwner
    transform s: JSL!TransferRelationDeclaration
    to t : JUDOPSM!Cardinality {
        t.setId("(jsl/" + s.getId() + ")/CreateCardinalityForGetRangeRelationTransferTypeInputOwner");
        t.lower = 0;
        t.upper = 1;
}

@lazy
@greedy
rule CreateCardinalityForGetRangeRelationTransferTypeInputQueryCustomizer
    transform s: JSL!TransferRelationDeclaration
    to t : JUDOPSM!Cardinality {
        t.setId("(jsl/" + s.getId() + ")/CreateCardinalityForGetRangeRelationTransferTypeInputQueryCustomizer");
        t.lower = 0;
        t.upper = 1;
}

@lazy
@greedy
rule CreateTransferObjectRelationForGetRangeRelationTransferTypeInputOwner
    transform s: JSL!TransferRelationDeclaration
    to t : JUDOPSM!TransferObjectRelation {
        t.setId("(jsl/" + s.getId() + ")/GetRangeRelationTransferTypeInputOwner");
        t.name = "owner";
        t.target = s.eContainer.getTransferDeclarationEquivalent();
        t.embedded = true;
        t.cardinality = s.equivalent("CreateCardinalityForGetRangeRelationTransferTypeInputOwner");
}

@lazy
@greedy
rule CreateTransferObjectRelationForGetRangeRelationTransferTypeInputQueryCustomizer
    transform s: JSL!TransferRelationDeclaration
    to t : JUDOPSM!TransferObjectRelation {
        t.setId("(jsl/" + s.getId() + ")/GetRangeRelationTransferTypeInputQueryCustomizer");
        t.name = "queryCustomizer";
        t.target = s.referenceType.equivalent("CreateQueryCustomizerType");
        t.embedded = true;
        t.cardinality = s.equivalent("CreateCardinalityForGetRangeRelationTransferTypeInputQueryCustomizer");
}

@lazy
@greedy
rule CreateGetRangeInputType
    transform s: JSL!TransferRelationDeclaration
    to t: JUDOPSM!UnmappedTransferObjectType {
        t.setId("(jsl/" + s.getId() + ")/GetRangeInputType");

        t.name = "_GetRangeInput" + s.eContainer.eContainer.name.firstToUpperCase() + s.eContainer.name.firstToUpperCase() + s.name.firstToUpperCase();

        t.relations.add(s.equivalent("CreateTransferObjectRelationForGetRangeRelationTransferTypeInputOwner"));

        if (s.referenceType.map.isDefined()) {
            t.relations.add(s.equivalent("CreateTransferObjectRelationForGetRangeRelationTransferTypeInputQueryCustomizer"));
        }

        s.eContainer.eContainer.getModelRoot().elements.add(t);
        log.debug("Get range input type created: " + t.name);
}
