@lazy
@greedy
rule CreateGetRangeInputType
    transform s: JSL!TransferRelationDeclaration
    to t: JUDOPSM!UnmappedTransferObjectType {
        t.setId("(esm/" + s.getId() + ")/GetRangeInputType");

        t.name = "_GetRangeInput" + s.eContainer.name.firstToUpperCase() + s.name.firstToUpperCase();

        var owner = new JUDOPSM!TransferObjectRelation;
        owner.setId("(jsl/" + s.getId() + ")/GetRangeInputType/Owner");
        owner.name = "owner";
        owner.target = s.eContainer.getTransferDeclarationEquivalent();
        owner.embedded = true;
        owner.cardinality = new JUDOPSM!Cardinality;
        owner.cardinality.setId("(jsl/" + s.getId() + ")/GetRangeInputType/Owner/Cardinality");
        owner.cardinality.lower = 0;
        owner.cardinality.upper = 1;

        t.relations.add(owner);

        if (s.target.mapping.isDefined()) {
            var queryCustomizer = new JUDOPSM!TransferObjectRelation;
            queryCustomizer.setId("(esm/" + s.getId() + ")/GetRangeInputType/QueryCustomizer");
            queryCustomizer.name = "queryCustomizer";
            queryCustomizer.target = s.target.equivalent("CreateQueryCustomizerType");
            queryCustomizer.embedded = true;
            queryCustomizer.cardinality = new JUDOPSM!Cardinality;
            queryCustomizer.cardinality.setId("(esm/" + s.getId() + ")/GetRangeInputType/QueryCustomizer/Cardinality");
            queryCustomizer.cardinality.lower = 0;
            queryCustomizer.cardinality.upper = 1;
            t.relations.add(queryCustomizer);
        }

        s.eContainer.eContainer.getModelRoot().elements.add(t);
        log.debug("Get range input type created: " + t.name);
}