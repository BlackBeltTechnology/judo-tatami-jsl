@cached
operation JSL!UIActionDeclaration getId(): String {
    return (self.eContainer.getId() + "/" + self.name);
}

@cached
operation JSL!UIActionDeclaration getFqName(): String {
    return self.eContainer.getFqName() + "::" + self.name;
}

@cached
operation JSL!UIActionDeclaration isCallAction(): Boolean {
    return not self.parameterType.isDefined();
}

@cached
operation JSL!UIActionDeclaration isOpenOperationSelectorAction(): Boolean {
    if (self.parameterType.isDefined()) {
        return self.transferAction.map.isDefined();
    }
    return false;
}

@cached
operation JSL!UIActionDeclaration isOpenOperationFormAction(): Boolean {
    if (self.parameterType.isDefined()) {
        return self.parameterType.form;
    }
    return false;
}

@cached
operation JSL!UIActionDeclaration hasOutput(): Boolean {
    return self.transferAction.target.hasOutput();
}
