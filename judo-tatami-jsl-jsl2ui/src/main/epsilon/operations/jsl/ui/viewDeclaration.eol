@cached
operation JSL!UIViewDeclaration getId(): String {
    return (self.eContainer.getId() + "/" + self.name);
}

@cached
operation JSL!UIViewDeclaration getFqName(): String {
    return self.eContainer.getFqName() + "::" + self.name;
}

operation JSL!UIViewDeclaration uiContainer() : UI!ui::VisualElement {
    if (self.form.isDefined() and self.form) {
        return self.equivalent("FormPageContainerVisualElement");
    }
    return self.equivalent("ViewPageContainerVisualElement");
}

operation JSL!UIViewDeclaration getExposedVisualElements(ves: Set): Set {
    if (ves.contains(self)) {
        return ves;
    }
    ves.add(self);
    ves.addAll(self.members.select(m | m.isTypeOf(JSL!UIViewWidgetDeclaration)).asSet());

    for (ad in self.members.select(m | m.isTypeOf(JSL!UIActionDeclaration)).asSet()) {
        ves.addAll(ad.getExposedVisualElements(ves));
    }

    for (link in self.members.select(m | m.isTypeOf(JSL!UIViewLinkDeclaration)).asSet()) {
        ves.addAll(link.getExposedVisualElements(ves));
    }

    for (table in self.members.select(m | m.isTypeOf(JSL!UIViewTableDeclaration)).asSet()) {
        ves.addAll(table.getExposedVisualElements(ves));
    }

    for (group in self.members.select(m | m.isKindOf(JSL!UIViewGroupDeclaration)).asSet()) {
        ves.addAll(group.getExposedVisualElements(ves));
    }

    for (tab in self.members.select(m | m.isKindOf(JSL!UIViewTabsDeclaration)).asSet()) {
        ves.addAll(tab.getExposedVisualElements(ves));
    }

    for (agd in self.members.select(m | m.isKindOf(JSL!UIActionGroupDeclaration)).asSet()) {
        ves.addAll(agd.getExposedVisualElements(ves));
    }

    return ves;
}

@cached
operation JSL!UIViewDeclaration getAllLinks(): Set {
    return self.getExposedVisualElements(new Set()).select(v | v.isKindOf(JSL!UIViewLinkDeclaration)).asSet();
}

@cached
operation JSL!UIViewDeclaration getOwnLinks(): Set {
    var all = self.getExposedVisualElements(new Set()).select(v | v.isKindOf(JSL!UIViewLinkDeclaration)).asSet();
    var res = new Set();

    for (link in all) {
        var parent: Any = link.eContainer;
        while (not parent.isTypeOf(JSL!UIViewDeclaration) and parent.isDefined()) {
            if (not parent.isTypeOf(JSL!UIViewDeclaration)) {
                parent = parent.eContainer;
            }
        }
        if (parent == self) {
            res.add(link);
        }
    }

    return res;
}

@cached
operation JSL!UIViewDeclaration getAllTables(): Set {
    return self.getExposedVisualElements(new Set()).select(v | v.isKindOf(JSL!UIViewTableDeclaration)).asSet();
}

@cached
operation JSL!UIViewDeclaration getOwnTables(): Set {
    var all = self.getExposedVisualElements(new Set()).select(v | v.isKindOf(JSL!UIViewTableDeclaration)).asSet();
    var res = new Set();

    for (table in all) {
        var parent: Any = table.eContainer;
        while (not parent.isTypeOf(JSL!UIViewDeclaration) and parent.isDefined()) {
            if (not parent.isTypeOf(JSL!UIViewDeclaration)) {
                parent = parent.eContainer;
            }
        }
        if (parent == self) {
            res.add(table);
        }
    }

    return res;
}

@cached
operation JSL!UIViewDeclaration getAllActionDeclarations() : List {
    var ves = new Set();

	for (group in self.members.select(m | m.isKindOf(JSL!UIViewGroupDeclaration)).asSet()) {
        ves.addAll(group.getAllActionDeclarations());
    }

    for (tab in self.members.select(m | m.isKindOf(JSL!UIViewTabsDeclaration)).asSet()) {
        ves.addAll(tab.getAllActionDeclarations());
    }

    for (agd in self.members.select(m | m.isKindOf(JSL!UIActionGroupDeclaration)).asSet()) {
        ves.addAll(agd.getAllActionDeclarations());
    }

    ves.addAll(self.members.select(m | m.isTypeOf(JSL!UIActionDeclaration)).asSet());

    return ves.sortBy(c | c.name + c.getId());
}
