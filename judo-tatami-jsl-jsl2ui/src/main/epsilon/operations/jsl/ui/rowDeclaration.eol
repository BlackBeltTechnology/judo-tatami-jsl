@cached
operation JSL!UIRowDeclaration getId(): String {
    return (self.eContainer.getId() + "/" + self.name);
}

@cached
operation JSL!UIRowDeclaration getFqName(): String {
    if (self.eContainer.isDefined()) {
        return self.eContainer.getFqName() + "::" + self.name;
    }
    return self.name;
}

operation JSL!UIRowDeclaration getExposedVisualElements(ves: Set): Set {
    if (ves.contains(self)) {
        return ves;
    }
    ves.add(self);
    ves.addAll(self.members.select(m | m.isTypeOf(JSL!UIRowColumnDeclaration)).asSet());
    for (ad in self.members.select(m | m.isKindOf(JSL!UIActionDeclaration)).asSet()) {
        ves.addAll(ad.getExposedVisualElements(ves));
    }

    return ves;
}

@cached
operation JSL!UIRowDeclaration getAllActionDeclarations(): Set {
    var ves = new Set();
    
    ves.addAll(self.members.select(m | m.isKindOf(JSL!UIActionDeclaration)).asSet());
    
    return ves;
}
