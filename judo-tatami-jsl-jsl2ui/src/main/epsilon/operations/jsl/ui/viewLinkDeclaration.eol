@cached
operation JSL!UIViewLinkDeclaration getId(): String {
    return (self.eContainer.getId() + "/" + self.name);
}

@cached
operation JSL!UIViewLinkDeclaration getFqName(): String {
    if (self.eContainer.isDefined()) {
        return self.eContainer.getFqName() + "::" + self.name;
    }
    return self.name;
}

@cached
operation JSL!UIViewLinkDeclaration getRelation(): TransferRelationDeclaration {
    return self.transferRelation.target;
}

operation JSL!UIViewLinkDeclaration getExposedVisualElements(ves: Set): Set {
    if (ves.contains(self)) {
        return ves;
    }
    var viewDeclaration = self.referenceType;

    ves.addAll(viewDeclaration.getExposedVisualElements(ves));

    if (self.getCreateFormModifier().isDefined()) {
        ves.addAll(self.getCreateFormModifier().form.getExposedVisualElements(ves));
    }

    if (self.getSelectorTableModifier().isDefined()) {
        ves.addAll(self.getSelectorTableModifier().row.getExposedVisualElements(ves));
    }

    return ves;
}
