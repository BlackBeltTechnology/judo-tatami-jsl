rule AccessLinkViewRefreshAction
    transform s: JSL!UIMenuLinkDeclaration
    to t: UI!ui::Action {
	    t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/AccessLinkViewRefreshAction");
 		t.name = s.name + "::Refresh";
