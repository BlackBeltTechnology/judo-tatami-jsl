rule CardPageContainer
    transform s: JSL!UICardDeclaration
    to t: UI!ui::PageContainer {
        guard: frontend.containsVisualElement(s)

        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardPageContainer");
        t.name = s.getFqName() + "::Card::PageContainer";
        t.label = s.getLabelWithNameFallback();
        t.titleFrom = UI!ui::TitleFrom#LABEL;
        t.type = UI!ui::PageContainerType#TABLE;
        t.children.add(s.equivalent("CardPageContainerVisualElement"));
        t.actionButtonGroups.add(s.equivalent("CardPageContainerButtonGroup"));
        t.dataElement = s.map.transfer.equivalent("ClassType");
        t.onInit = s.equivalent("TableTableRefreshActionDefinition");

        frontend.equivalent("Application").pageContainers.add(t);

        /*
        for (dataFeature in s.additionalMaskFeatures) {
            var attributeType = dataFeature.getMember().mapAttributeType(s.eContainer.equivalent("ClassType"));
            t.additionalMaskAttributes.add(attributeType);
        }
        */

        log.debug("Create CardPageContainer: " + t.name);
}

@lazy
rule CardPageContainerButtonGroup
    transform s: JSL!UICardDeclaration
    to t: UI!ui::ButtonGroup {
	    t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardPageContainerButtonGroup");
 		t.name = s.getFqName() + "::PageActions";
 		t.label = "Actions";

 		t.buttons.add(s.equivalent("CardPageContainerBackButton"));

        log.debug("CardPageContainerButtonGroup: " + t.name);
}

@lazy
rule CardPageContainerBackButtonIcon
    transform s: JSL!UICardDeclaration
    to t: UI!ui::Icon {
    	t.iconName = "arrow-left";
    	t.name = s.name + "BackIcon";
    	t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardPageContainerBackButtonIcon");
}

@lazy
rule CardPageContainerBackActionDefinition
    transform s: JSL!UICardDeclaration
    to t: UI!ui::BackActionDefinition {
	    t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardPageContainerBackActionDefinition");
 		t.name = s.getFqName() + "::Back";
        log.debug("CardPageContainerBackActionDefinition: " + t.name);
}

@lazy
rule CardPageContainerBackButton
    transform s: JSL!UICardDeclaration
    to t: UI!ui::Button {
	    t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardPageContainerBackButton");
 		t.name = s.getFqName() + "::Back";
    	t.label = "Back";
    	t.buttonStyle = "text";
    	t.icon = s.equivalent("CardPageContainerBackButtonIcon");
    	t.actionDefinition = s.equivalent("CardPageContainerBackActionDefinition");
        log.debug("CardPageContainerBackButton: " + t.name);
}

@lazy
rule CardPageContainerVisualElement
    transform s: JSL!UICardDeclaration
    to t: UI!ui::Flex {
        __pos.put(t, 0);
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardPageContainerVisualElement");
        t.name = s.name;
        t.direction = UI!Axis#VERTICAL;
        t.mainAxisAlignment = UI!ui::MainAxisAlignment#START;
        t.crossAxisAlignment = UI!ui::CrossAxisAlignment#STRETCH;
        t.col = 12d;
        t.children.add(s.equivalent("CardTable"));

        log.debug("CardPageContainerVisualElement: " + t.name);
}

@lazy
rule CardTable
    transform s: JSL!UICardDeclaration
    to t: UI!ui::Table {
        var id = frontend.name + "/(jsl/" + s.getId() + ")/CardTable";
        t.setId(id);
        t.col = 12d;
        t.label = s.getLabelWithNameFallback();
        t.name = s.name + "::Cards";
        t.dataElement = s.map.transfer.equivalent("ClassType");
        t.relationName = "";
        t.isInlineEditable = true;
        t.representationComponent = UI!ui::TableRepresentation#CARD;
        if (__pos.get(t).isUndefined()) {
            __pos.put(t, 0);
        }

        var primitiveFields = s.members.select(m | m.transferField.isDefined() and m.transferField.target.referenceType.`primitive`.isDefined());

        for (field in primitiveFields) {
            var col = field.equivalentDiscriminated("CardWidgetDeclarationPrimitiveColumn", id);
            t.columns.add(col);
            if (col.attributeType.isFilterable) {
               t.filters.add(field.equivalentDiscriminated("CardWidgetDeclarationPrimitiveColumnFilter", id));
            }
        }

        t.tableActionButtonGroup = s.equivalent("CardTableButtonGroup");
        t.rowActionButtonGroup = s.equivalent("CardTableRowButtonGroup");

        // TODO transform selector row per page
        t.selectorRowsPerPage = 10;

        log.debug("CardTable: " + t.name);
}

@lazy
rule CardTableButtonGroup
    transform s: JSL!UICardDeclaration
    to t: UI!ui::ButtonGroup {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardTableButtonGroup");
        t.name = s.name + "::CardTableButtonGroup";
        t.label = "Actions";

        // TODO add buttons

        t.buttons.add(s.equivalent("CardTableFilterButton"));
        t.buttons.add(s.equivalent("CardTableRefreshButton"));

        log.debug("CardTableButtonGroup: " + t.name);
}

