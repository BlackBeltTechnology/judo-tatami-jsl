@lazy
rule CardWidgetDeclarationPrimitiveColumn
    transform s: JSL!UIViewWidgetDeclaration
    to t: UI!ui::Column {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardWidgetDeclarationPrimitiveColumn");
        t.name = s.name;
        t.format = "%s";
        t.label = s.getLabelWithNameFallback();
        if (s.getIconModifier().isDefined()) {
            t.icon = s.equivalent("CardColumnDeclarationColumnIcon");
        }
        t.width = s.getWidth().isDefined() ? s.getWidth().value : "120";
        t.attributeType = s.getTransferFieldDeclarationEquivalent();

        log.debug("CardWidgetDeclarationPrimitiveColumn: " + t.name);
}

@lazy
rule CardColumnDeclarationColumnIcon
    transform s: JSL!UIViewWidgetDeclaration
    to t: UI!ui::Icon {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardColumnDeclarationColumnIcon");
        t.iconName = s.getIconModifier().value.value;
        t.name = s.name + "FieldIcon";

        log.debug("CardColumnDeclarationColumnIcon: " + t.name);
}

@lazy
rule CardWidgetDeclarationPrimitiveColumnFilter
    transform s: JSL!UIViewWidgetDeclaration
    to t: UI!ui::Filter {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/CardWidgetDeclarationPrimitiveColumnFilter");
        t.name = s.name + "Filter";
        t.attributeType = s.getTransferFieldDeclarationEquivalent();
        t.label = s.getLabelWithNameFallback();
        log.debug("CardWidgetDeclarationPrimitiveColumnFilter: " + t.name);
}
