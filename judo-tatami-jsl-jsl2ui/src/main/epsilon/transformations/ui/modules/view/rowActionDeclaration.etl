@lazy
rule RowActionDeclarationButton
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::Button {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/RowActionDeclarationButton");
        t.name = s.name;
        var label = s.getLabelModifier();
        if (label.isDefined()) {
            t.label = label.value.value;
        }
        if (t.label.isUndefined() and t.icon.isUndefined()) {
            t.label = t.name;
        }

        var icon = s.getIconModifier();
        if (icon.isDefined()) {
            t.icon = icon.equivalent("IconModifierIcon");
        }

        if (s.getHelpModifier().isDefined()) {
            t.tooltipText = s.getHelpModifier().value.value;
        }

        if (__pos.get(s).isDefined()) {
            __pos.put(t, __pos.get(s));
        } else {
            __pos.put(t, 0);
        }

        if (s.isOpenOperationFormAction()) {
            t.actionDefinition = s.equivalent("RowActionDeclarationOpenFormActionDefinition");
        } else if (s.isOpenOperationSelectorAction()) {
            t.actionDefinition = s.equivalent("RowActionDeclarationOpenSelectorActionDefinition");
        } else {
            t.actionDefinition = s.equivalent("RowActionDeclarationCallOperationActionDefinition");
        }

        t.dataElement = s.transferAction.target.equivalent("OperationType");

        log.debug("Create RowActionDeclarationButton: " + t.name);
}

@lazy
rule RowActionDeclarationCallOperationActionDefinition
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::ParameterlessCallOperationActionDefinition {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/RowActionDeclarationCallOperationActionDefinition");
    	t.name = s.getFqName() + "::Call";
    	t.`operation` = s.transferAction.target.equivalent("OperationType");
    	t.targetType = s.transferAction.target.parameterType.equivalent("ClassType");

        log.debug("RowActionDeclarationCallOperationActionDefinition: " + t.name);
}

@lazy
rule RowActionDeclarationOpenSelectorActionDefinition
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::OpenOperationInputSelectorActionDefinition {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/RowActionDeclarationOpenSelectorActionDefinition");
        t.name = s.getFqName() + "::Open::Selector";
        t.targetType = s.getSelectorTableModifier().row.map.transfer.equivalent("ClassType");
 		t.selectorFor = s.equivalent("OperationInputSelectorCallActionDefinition");
        log.debug("RowActionDeclarationOpenSelectorActionDefinition: " + t.name);
}

@lazy
rule RowActionDeclarationOpenFormActionDefinition
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::OpenOperationInputFormActionDefinition {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/RowActionDeclarationOpenFormActionDefinition");
    	t.name = s.getFqName() + "::Open::Operation::Form";
        // t.targetType = s.transferAction.target.parameterType.equivalent("ClassType");
        log.debug("RowActionDeclarationOpenFormActionDefinition: " + t.name);
}

@lazy
rule RowAction
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::Action {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/RowAction");
        t.name = s.getFqName() + "::Action";

        if (s.isOpenOperationFormAction()) {
            t.targetPageDefinition = s.equivalent("OperationInputFormPageDefinition");
            t.actionDefinition = s.equivalent("RowActionDeclarationOpenFormActionDefinition");
            t.actionDefinition.formFor = s.equivalent("OperationInputFormCallActionDefinition");
        } else if (s.isOpenOperationSelectorAction()) {
            t.targetPageDefinition = s.equivalent("OperationInputSelectorPageDefinition");
            t.actionDefinition = s.equivalent("RowActionDeclarationOpenSelectorActionDefinition");
        } else {
            if (s.hasOutput()) {
                t.targetPageDefinition = s.equivalent("OperationOutputPageDefinition");
            }
            t.actionDefinition = s.equivalent("RowActionDeclarationCallOperationActionDefinition");
        }

        log.debug("RowAction: " + t.name);
}
