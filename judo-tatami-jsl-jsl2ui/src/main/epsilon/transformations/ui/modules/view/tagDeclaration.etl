@lazy
rule TagWidgetDeclarationPrimitiveColumn
    transform s: JSL!UITagDeclaration
    to t: UI!ui::Column {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/TagWidgetDeclarationPrimitiveColumn");
        t.name = s.name;
        t.format = "%s";
        t.label = s.name;
        t.width = "120";
        t.attributeType = s.getTransferFieldDeclaration().getTransferFieldDeclarationEquivalent();

        log.debug("TagWidgetDeclarationPrimitiveColumn: " + t.name);
}

@lazy
rule TagWidgetDeclarationPrimitiveColumnFilter
    transform s: JSL!UITagDeclaration
    to t: UI!ui::Filter {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/TagWidgetDeclarationPrimitiveColumnFilter");
        t.name = s.name + "Filter";
        t.attributeType = s.getTransferFieldDeclaration().getTransferFieldDeclarationEquivalent();
        t.label = s.name;
        log.debug("TagWidgetDeclarationPrimitiveColumnFilter: " + t.name);
}
