rule ViewActionDeclarationButton
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::Button {
        guard: rootMenu.containsVisualElement(s)

        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/ViewActionDeclarationButton");
        t.name = s.name;
        var label = s.getLabelModifier();
        if (label.isDefined()) {
            t.label = label.value.value;
        }
        if (t.label.isUndefined() and t.icon.isUndefined()) {
            t.label = t.name;
        }

        var icon = s.getIconModifier();
        if (icon.isDefined()) {
            t.icon = icon.equivalent("IconModifierIcon");
        }
        t.dataElement = s.equivalent("OperationType");

        if (__pos.get(s).isDefined()) {
            __pos.put(t, __pos.get(s));
        } else {
            __pos.put(t, 0);
        }

        if (s.isOpenOperationFormAction()) {
            t.actionDefinition = s.equivalent("ViewActionDeclarationOpenFormActionDefinition");
        } else if (s.isOpenOperationSelectorAction()) {
            t.actionDefinition = s.equivalent("ViewActionDeclarationOpenSelectorActionDefinition");
        } else {
            t.actionDefinition = s.equivalent("ViewActionDeclarationCallOperationActionDefinition");
        }

        t.dataElement = s.transferAction.target.equivalent("OperationType");

        s.eContainer.uiContainer().children.add(t);

        log.debug("Create ViewActionDeclarationButton: " + t.name);
}

@lazy
rule ViewActionDeclarationCallOperationActionDefinition
