@lazy
rule OperationOutputPageDefinition
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::PageDefinition {
		var id = rootMenu.name + "/(jsl/" + s.getId() + ")/OperationOutputPageDefinition";
		var uiOp = s.transferAction.target.equivalent("OperationType");

        t.setId(id);
	    t.name = s.name + "::OperationOutput";
	    t.container = s.`return`.equivalent("ViewPageContainer");
	    t.dataElement = uiOp.output;
	    t.openInDialog = true;
	    t.dialogSize = UI!ui::DialogSize#LG;

	    t.actions.add(s.equivalent("OperationOutputBackAction"));

	    if (s.`return`.map.isDefined()) {
	        if (s.`return`.map.transfer.isRefreshSupported()) {
	            t.actions.add(s.equivalent("OperationOutputRefreshAction"));
	        }
	    	if (s.`return`.map.transfer.isUpdateSupported()) {
		        t.actions.add(s.equivalent("OperationOutputCancelAction"));
		        t.actions.add(s.equivalent("OperationOutputUpdateAction"));
	    	}
	    	if (s.`return`.map.transfer.isDeleteSupported()) {
		        t.actions.add(s.equivalent("OperationOutputDeleteAction"));
	    	}

	        for (ad in s.`return`.getAllActionDeclarations()) {
		    	var operationCallAction = ad.equivalentDiscriminated("OperationOutputCallAction", id);
		    	operationCallAction.actionDefinition = ad.getActionDefinitionForView(ad.getDiscriminator());
		        operationCallAction.ownerDataElement = uiOp;
		        operationCallAction.targetDataElement = uiOp;

		        if (op?.input?.target == ad?.getOperationReference()?.getMember()?.input?.target) {
                    operationCallAction.targetPageDefinition = t;
                }

	    		t.actions.add(operationCallAction);
        	}
            /*
			for (tabularReferenceField in s.`return`.getAllTabularReferenceFields().select(f | f.isAvailable())) {
			    t.actions.addAll(tabularReferenceField.calculateActions(id, uiOp, false));
			    t.actions.addAll(tabularReferenceField.calculateReferencedRelationTableAndRowActions(id, uiOp));
			}
			*/
        }

        rootMenu.equivalent("Application").pages.add(t);

        log.debug("OperationOutputPageDefinition " + t.name);
}

