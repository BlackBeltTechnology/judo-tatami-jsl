@lazy
rule ViewAction
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::Action {
   	    t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/ViewAction");
 		t.name = s.getFqName() + "::Action";

		if (s.isOpenOperationFormAction()) {
            t.targetPageDefinition = s.equivalent("OperationInputFormPageDefinition");
            t.actionDefinition = s.equivalent("ViewActionDeclarationOpenFormActionDefinition");
            t.actionDefinition.formFor = s.equivalent("OperationInputFormCallActionDefinition");
        } else if (s.isOpenOperationSelectorAction()) {
            t.targetPageDefinition = s.equivalent("OperationInputSelectorPageDefinition");
            t.actionDefinition = s.equivalent("ViewActionDeclarationOpenSelectorActionDefinition");
        } else {
            if (s.hasOutput()) {
                t.targetPageDefinition = s.equivalent("OperationOutputViewPageDefinition");
            }
            t.actionDefinition = s.equivalent("ViewActionDeclarationCallOperationActionDefinition");
        }

        log.debug("ViewAction: " + t.name);
}

@lazy
rule OperationInputFormPageDefinition
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::PageDefinition {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/OperationInputFormPageDefinition");
        t.openInDialog = true;
        t.name = s.getFqName() + "::OperationInputForm";
        t.container = s.parameterType.equivalent("FormPageContainer");
        t.dataElement = s.transferAction.target.equivalent("OperationInputParameterType");

        t.actions.add(s.equivalent("OperationInputFormBackAction"));
        t.actions.add(s.equivalent("OperationInputFormCallAction"));
        if (s.transferAction.target.parameterType.isGetTemplateSupported()) {
            t.actions.add(s.equivalent("OperationInputFormGetTemplateAction"));
        }

        t.container.actionButtonGroup.buttons.add(s.equivalent("OperationInputFormCallActionButton"));

        rootMenu.equivalent("Application").pages.add(t);

        log.debug("Create OperationInputFormPageDefinition: " + t.name);
}

