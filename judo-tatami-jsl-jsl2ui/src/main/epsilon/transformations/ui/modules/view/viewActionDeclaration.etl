@lazy
rule OperationInputSelectorPageDefinition
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::PageDefinition {
        t.setId(rootMenu.name + "/(jsl/" + s.getId() + ")/OperationInputSelectorPageDefinition");
        t.name = s.getFqName() + "::OperationInputSelector";
        t.openInDialog = true;
        t.container = s.getSelectorTableModifier().row.equivalent("TablePageContainer");
        t.isSelector = true;
        t.container.actionButtonGroup.buttons.add(s.equivalent("OperationInputSelectorCallActionButton"));
        t.dataElement = s.transferAction.target.equivalent("OperationType").input;

        t.actions.add(s.equivalent("OperationInputSelectorBackAction"));
        t.actions.add(s.equivalent("OperationInputSelectorRangeAction"));
        t.actions.add(s.equivalent("OperationInputSelectorFilterAction"));
        t.actions.add(s.equivalent("OperationInputSelectorCallAction"));

        rootMenu.equivalent("Application").pages.add(t);

        log.debug("OperationInputSelectorPageDefinition: " + t.name);
}

