rule InlineViewTags
    transform s: JSL!UIViewTableDeclaration
    to t: UI!ui::Table
    extends AbstractViewTableDeclaration {
        guard: frontend.containsVisualElement(s) and s.referenceType.isTypeOf(JSL!UITagDeclaration)

        var id = frontend.name + "/(jsl/" + s.getId() + ")/InlineViewTags";
        t.setId(id);
        t.dataElement = s.transferRelation.target.equivalent("RelationType");
        s.eContainer.uiContainer().children.add(t);
        t.representationComponent = UI!ui::TableRepresentation#CARD;
        t.label = s.getLabelWithNameFallback(); // Tags behave like input components, so we apply a fallback here

        var col = s.referenceType.equivalentDiscriminated("TagWidgetDeclarationPrimitiveColumn", id);
        t.columns.add(col);
        if (col.attributeType.isFilterable) {
           t.filters.add(s.referenceType.equivalentDiscriminated("TagWidgetDeclarationPrimitiveColumnFilter", id));
        }

        t.tableActionButtonGroup = s.equivalent("InlineViewTagsButtonGroup");
        t.rowActionButtonGroup = s.equivalent("InlineViewTagsRowButtonGroup");

        t.autocompleteRangeActionDefinition = s.equivalent("ViewTagsDeclarationAutocompleteRangeActionDefinition");
        t.autocompleteAddActionDefinition = s.equivalent("ViewTagsDeclarationAutocompleteAddActionDefinition");

        // TODO transform selector row per page
        t.selectorRowsPerPage = 10;

        log.debug("InlineViewTags: " + t.name);
}

