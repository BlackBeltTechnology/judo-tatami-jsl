@lazy
rule ViewTableActionDeclarationButton
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::Button {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/ViewTableActionDeclarationButton");
        t.name = s.name;
        t.buttonStyle = "text";
        var label = s.getLabelModifier();
        if (label.isDefined()) {
            t.label = label.value.value;
        }
        if (t.label.isUndefined() and t.icon.isUndefined()) {
            t.label = t.name;
        }

        var icon = s.getIconModifier();
        if (icon.isDefined()) {
            t.icon = icon.equivalent("IconModifierIcon");
        }

        if (__pos.get(s).isDefined()) {
            __pos.put(t, __pos.get(s));
        } else {
            __pos.put(t, 0);
        }

        if (s.isOpenOperationFormAction()) {
            t.actionDefinition = s.equivalent("ViewTableActionDeclarationOpenFormActionDefinition");
        } else if (s.isOpenOperationSelectorAction()) {
            t.actionDefinition = s.equivalent("ViewTableActionDeclarationOpenSelectorActionDefinition");
        } else {
            t.actionDefinition = s.equivalent("ViewTableActionDeclarationCallOperationActionDefinition");
        }

        t.dataElement = s.transferAction.target.equivalent("OperationType");

        log.debug("Create ViewTableActionDeclarationButton: " + t.name);
}

@lazy
rule ViewTableActionDeclarationCallOperationActionDefinition
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::ParameterlessCallOperationActionDefinition {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/ViewTableActionDeclarationCallOperationActionDefinition");
    	t.name = s.getFqName() + "::Call";
    	t.`operation` = s.transferAction.target.equivalent("OperationType");
    	t.targetType = s.transferAction.target.parameterType.equivalent("ClassType");
    	t.isContainedRelationAction = not s.eContainer.isKindOf(JSL!ActionGroupModifier);

        log.debug("ViewTableActionDeclarationCallOperationActionDefinition: " + t.name);
}

@lazy
rule ViewTableActionDeclarationOpenSelectorActionDefinition
    transform s: JSL!UIActionDeclaration
    to t: UI!ui::OpenOperationInputSelectorActionDefinition {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/ViewTableActionDeclarationOpenSelectorActionDefinition");
        t.name = s.getFqName() + "::Open::Selector";
        t.targetType = s.getSelectorTableModifier().row.map.transfer.equivalent("ClassType");
        t.isContainedRelationAction = true;
 		t.selectorFor = s.equivalent("OperationInputSelectorCallActionDefinition");
        log.debug("ViewTableActionDeclarationOpenSelectorActionDefinition: " + t.name);
}

@lazy
rule ViewTableActionDeclarationOpenFormActionDefinition
