@abstract
rule AbstractViewTableDeclaration
    transform s: JSL!UIViewTableDeclaration
    to t: UI!ui::Table {
        guard: frontend.containsVisualElement(s)

        t.name = s.name;
        t.relationName = s.transferRelation.target.name;
        if (s.getLabelModifier().isDefined()) {
            t.label = s.getLabelModifier().value.value;
        }
        if (s.getIconModifier().isDefined()) {
            t.icon = s.equivalent("TableIcon");
        }
        t.row = 1d;
        t.col = s.getWidth().isDefined() ? s.getWidth().value.asReal() : 12d;
        t.isEager = s.transferRelation.target.isEager();
        t.isInlineEditable = t.isEager; // TODO JNG-6043 Currently the runtime only supports inline edit for eager tables
        if (__pos.get(s).isDefined()) {
            __pos.put(t, __pos.get(s));
        } else {
            __pos.put(t, 0);
        }
}

@abstract
rule AbstractViewTableActionDefinition
    transform s: JSL!UIViewTableDeclaration
    to t: UI!ui::ActionDefinition {

    t.isContainedRelationAction = true;
}

@lazy
rule TableIcon
    transform s: JSL!UIViewTableDeclaration
    to t: UI!ui::Icon {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/TableIcon");
        t.name = s.name + "TableIcon";
        t.iconName = s.getIconModifier().value.value;
}

rule InlineViewCards
    transform s: JSL!UIViewTableDeclaration
    to t: UI!ui::Table
    extends AbstractViewTableDeclaration {
        guard: frontend.containsVisualElement(s) and s.referenceType.isTypeOf(JSL!UICardDeclaration)

        var id = frontend.name + "/(jsl/" + s.getId() + ")/InlineViewCards";
        t.setId(id);
        t.dataElement = s.transferRelation.target.equivalent("RelationType");
        s.eContainer.uiContainer().children.add(t);
        t.representationComponent = UI!ui::TableRepresentation#CARD;

        var primitiveFields = s.referenceType.members.select(m | m.transferField.isDefined() and m.transferField.target.referenceType.`primitive`.isDefined());

        for (field in primitiveFields) {
            var col = field.equivalentDiscriminated("CardWidgetDeclarationPrimitiveColumn", id);
            t.columns.add(col);
            if (col.attributeType.isFilterable) {
               t.filters.add(field.equivalentDiscriminated("CardWidgetDeclarationPrimitiveColumnFilter", id));
            }
        }

        t.tableActionButtonGroup = s.equivalent("InlineViewCardsButtonGroup");
        t.rowActionButtonGroup = s.equivalent("InlineViewCardsRowButtonGroup");

        // TODO transform selector row per page
        t.selectorRowsPerPage = 10;

        log.debug("InlineViewCards: " + t.name);
}

@lazy
rule InlineViewCardsButtonGroup
    transform s: JSL!UIViewTableDeclaration
    to t: UI!ui::ButtonGroup {
        t.setId(frontend.name + "/(jsl/" + s.getId() + ")/InlineViewCardsButtonGroup");
        t.name = s.name + "::InlineViewCardsButtonGroup";
        t.label = "Actions";

        // TODO add buttons

        t.buttons.add(s.equivalent("InlineViewCardsFilterButton"));
        t.buttons.add(s.equivalent("InlineViewCardsRefreshButton"));

        log.debug("InlineViewCardsButtonGroup: " + t.name);
}


